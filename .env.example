# settle-api is TESTNET ONLY. It refuses to start on any other network.
SETTLE_NETWORK=testnet

# REQUIRED. The USDC issuer this service quotes and verifies, never taken from a client.
# For the public Stellar testnet, Circle's USDC issuer is commonly used:
#   GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Confirm it against current Stellar/Circle documentation before relying on it.
SETTLE_USDC_ISSUER=

SETTLE_HORIZON_URL=https://horizon-testnet.stellar.org
HOST=127.0.0.1
PORT=8787

# Quote lifetime, rate limit and fee ceiling.
SETTLE_QUOTE_TTL_SECONDS=300
SETTLE_RATE_LIMIT_PER_MINUTE=60
SETTLE_BASE_FEE_STROOPS=100
SETTLE_MAX_FEE_STROOPS=10000
SETTLE_MIN_CONTRIBUTION_MINOR=100
SETTLE_EXPIRY_GRACE_SECONDS=120

# Origins allowed to call the API from a browser (comma separated).
SETTLE_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Where state and the receipt ledger are written. Keep this private.
SETTLE_DATA_DIR=./data
